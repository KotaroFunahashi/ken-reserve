{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "docker-up",
            "type": "shell",
            "command": "docker-compose up -d",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "docker-down",
            "type": "shell",
            "command": "docker-compose down",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "bootRun",
            "type": "shell",
            "command": "./gradlew bootRun",
            "isBackground": true,
            "dependsOn": [
                "docker-up"
            ],
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting KenReserveApplication",
                    "endsPattern": "Started KenReserveApplication in"
                }
            }
        }
    ]
}
